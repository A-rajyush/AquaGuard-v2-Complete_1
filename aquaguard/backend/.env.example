NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# JWT Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES=7d

# PostgreSQL (leave blank to use in-memory store)
DATABASE_URL=postgresql://aquaguard:password@localhost:5432/aquaguard

# AWS (production SageMaker swap-in)
AWS_REGION=ap-south-1
SAGEMAKER_ENDPOINT=aquaguard-ml-v1
